[Unit]
Description=AirPlay Metadata JSON Export (shairport-sync)
After=network.target

[Service]
Type=simple
# aplmeta.py atomically replaces /var/local/www/aplmeta.txt and writes
# AirPlay cover files; keep one root-owned reader for those paths.
User=root
Restart=always
RestartSec=2
ExecStart=/var/www/daemon/aplmeta-reader.sh

[Install]
WantedBy=multi-user.target
